rules_version = '2';

// ============================================================
// WastePro — règles Firestore (projet : waste-pro-f67a5)
// ------------------------------------------------------------
// ⚠️ RESTAURÉ : le commit 8ecd422 avait durci ces règles en exigeant une
// session Firebase Auth (email dérivé du numéro). Cette migration a cassé
// la connexion des comptes créés directement dans la console Firebase
// (numéro + mot de passe stockés dans la collection `users`).
// On revient donc aux règles ouvertes pour que la connexion par
// numéro + mot de passe fonctionne de bout en bout, y compris la
// console super admin et le backoffice.
//
// 🏗️ STRUCTURE MULTI-TENANT (Phases 2-3) :
//   - `societes`   : entreprises (doc id = societeId)
//   - `agences`    : agences, liées à leur entreprise via `societeId`
//   - `utilisateurs` : comptes console (General Administrator /
//     Agency Manager), scopés par `societeId` (+ `agenceId`)
//   - `users`      : comptes de connexion (clé = numéro +237…), portent
//     `societeId` / `agenceId` et le rôle de connexion
//     (super_admin | general_admin | agency_manager | client | collector)
//   - `clients`, `collecteurs` : données d'exploitation scopées par
//     `agenceId` (Phase 3)
//
// 🔒 PLAN DE DURCISSEMENT (à déployer DÈS qu'une vraie session sécurisée
// sera intégrée — Firebase Auth + hachage des mots de passe) :
//   1. `users` : read limité au doc du requérant, write via Cloud Functions
//      ou après vérification du mot de passe actuel.
//   2. `societes` / `agences` / `utilisateurs` : réservés au super admin
//      et aux General Administrator de l'entreprise concernée
//      (`request.resource.data.societeId == request.auth.token.societeId`).
//   3. `clients` / `collecteurs` : réservés au chef d'agence concerné
//      (`request.resource.data.agenceId == request.auth.token.agenceId`).
// La version durcie du commit 8ecd422 reste disponible dans l'historique
// git comme point de départ.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Comptes & profils (login numéro + mot de passe) ---
    match /users/{phone} {
      allow read, write: if true;
    }

    // Profils de règles (rôle + scope), consultés par firestore.rules.
    // Règles OUVERTES pendant la migration Auth (comptes créés par
    // `tool/migrate_auth.mjs`) — à durcir avec les autres collections.
    match /auth_profiles/{uid} {
      allow read, write: if true;
    }

    // Liste blanche des collecteurs (pré-approbation admin)
    match /collectors/{phone} {
      allow read, write: if true;
    }

    // Backoffice entreprise : clients & collecteurs gérés par l'admin
    match /clients/{id} {
      allow read, write: if true;
    }

    match /collecteurs/{id} {
      allow read, write: if true;
    }

    // --- Abonnements / collectes ---
    match /subscriptions/{id} {
      allow read, write: if true;
    }

    match /contracts/{id} {
      allow read, write: if true;
    }

    match /pickups/{id} {
      allow read, write: if true;
    }

    // Paiements : transactions enregistrées après un encaissement CamPay,
    // lues par l'écran « My Bill » du client.
    match /transactions/{id} {
      allow read, write: if true;
    }

    // --- Console super admin & console entreprise ---
    match /societes/{id} {
      allow read, write: if true;
    }

    match /agences/{id} {
      allow read, write: if true;
    }

    match /utilisateurs/{id} {
      allow read, write: if true;
    }

    // --- Candidatures clients (pré-inscription) ---
    // Le client écrit sa candidature (status 'pending'), le chef d'agence
    // la lit et l'approuve/rejette dans son backoffice.
    match /registrations/{id} {
      allow read, write: if true;
    }

    // --- Notifications in-app (décisions du chef d'agence) ---
    // Écrites par le backoffice à l'approbation/rejet d'une candidature,
    // lues par l'app client (cloche du dashboard).
    match /notifications/{id} {
      allow read, write: if true;
    }
  }
}
