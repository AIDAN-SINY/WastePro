rules_version = '2';

// ============================================================
// WastePro — règles Firestore (projet : waste-pro-f67a5)
// ------------------------------------------------------------
// ⚠️ STADE ACTUEL :
// L'app n'utilise PAS encore Firebase Auth — la connexion se
// fait par numéro de téléphone + mot de passe stocké dans la
// collection `users`. Les règles sont donc ouvertes
// (lecture/écriture autorisées) pour que l'application
// fonctionne de bout en bout, y compris la console super admin.
// → À durcir dès que Firebase Auth sera intégré (request.auth).
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Comptes & profils ---
    match /users/{phone} {
      allow read, write: if true;
    }

    // Liste blanche des collecteurs (pré-approbation admin)
    match /collectors/{phone} {
      allow read, write: if true;
    }

    // Backoffice entreprise : clients & collecteurs gérés par l'admin
    match /clients/{id} {
      allow read, write: if true;
    }

    match /collecteurs/{id} {
      allow read, write: if true;
    }

    // --- Abonnements / collectes ---
    match /subscriptions/{id} {
      allow read, write: if true;
    }

    match /contracts/{id} {
      allow read, write: if true;
    }

    match /pickups/{id} {
      allow read, write: if true;
    }

    // --- Console super admin ---
    match /societes/{id} {
      allow read, write: if true;
    }

    match /agences/{id} {
      allow read, write: if true;
    }

    match /utilisateurs/{id} {
      allow read, write: if true;
    }
  }
}
