rules_version = '2';

// ============================================================
// WastePro — règles Firestore (projet : waste-pro-f67a5)
// ------------------------------------------------------------
// ⚠️ RESTAURÉ : le commit 8ecd422 avait durci ces règles en exigeant une
// session Firebase Auth (email dérivé du numéro). Cette migration a cassé
// la connexion des comptes créés directement dans la console Firebase
// (numéro + mot de passe stockés dans la collection `users`).
// On revient donc aux règles ouvertes pour que la connexion par
// numéro + mot de passe fonctionne de bout en bout, y compris la
// console super admin et le backoffice.
// → À durcir à nouveau dès qu'une vraie session sécurisée sera intégrée
//   (la version durcie est conservée dans l'historique git, commit 8ecd422).
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Comptes & profils ---
    match /users/{phone} {
      allow read, write: if true;
    }

    // Liste blanche des collecteurs (pré-approbation admin)
    match /collectors/{phone} {
      allow read, write: if true;
    }

    // Backoffice entreprise : clients & collecteurs gérés par l'admin
    match /clients/{id} {
      allow read, write: if true;
    }

    match /collecteurs/{id} {
      allow read, write: if true;
    }

    // --- Abonnements / collectes ---
    match /subscriptions/{id} {
      allow read, write: if true;
    }

    match /contracts/{id} {
      allow read, write: if true;
    }

    match /pickups/{id} {
      allow read, write: if true;
    }

    // --- Console super admin ---
    match /societes/{id} {
      allow read, write: if true;
    }

    match /agences/{id} {
      allow read, write: if true;
    }

    match /utilisateurs/{id} {
      allow read, write: if true;
    }
  }
}
