# CamPay DEMO credentials (copy to .env)
CAMPAY_ENV=demo
CAMPAY_APP_ID=
CAMPAY_USERNAME=
CAMPAY_PASSWORD=
CAMPAY_TOKEN=
CAMPAY_WEBHOOK_KEY=

# Hugging Face Inference Providers (required for AI chatbot)
# 1. https://huggingface.co/settings/tokens
# 2. Create a Fine-grained token
# 3. Enable permission: "Make calls to Inference Providers"
# 4. Paste below (starts with hf_) then restart the app
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct:fastest
