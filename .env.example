# CamPay DEMO credentials (copy to .env)
CAMPAY_ENV=demo
CAMPAY_APP_ID=
CAMPAY_USERNAME=
CAMPAY_PASSWORD=
CAMPAY_TOKEN=
CAMPAY_WEBHOOK_KEY=

# Hugging Face Inference Providers (required for AI chatbot)
# Create a token at https://huggingface.co/settings/tokens
# Enable "Make calls to Inference Providers" permission.
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct:fastest
